# ==========================================
# Premium Task Tracker — Multi-Language Monorepo .gitignore
# ==========================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Node / Frontend
node_modules/
dist/
build/
coverage/
.npm
.yarn/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# PHP / Composer
vendor/
composer.phar
*.cache
.phpunit.result.cache

# Python (FastAPI / Flask Analytics Service)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Go (Golang WebSocket Service)
bin/
pkg/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work

# Java & Spring Boot (Maven / Gradle)
target/
*.class
*.jar
*.war
*.ear
*.nar
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Runtime dumps
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump

# Operating Systems & IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains / IntelliJ / VS Code
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

